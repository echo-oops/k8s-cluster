# File: ansible/roles/kubernetes/templates/kubeadm-join.sh.j2
#!/usr/bin/env bash
# kubeadm-join.sh
# Generated by Ansible template. This script will attempt to join the node to the control-plane
# using the provided join command. It performs basic validation and retries to handle transient errors.

set -euo pipefail

JOIN_CMD="{{ join_command | default('') }}"
KUBEADM_FLAGS="${KUBEADM_FLAGS:-}"
RETRY_COUNT="${RETRY_COUNT:-6}"
RETRY_DELAY="${RETRY_DELAY:-10}"

if [[ -z "${JOIN_CMD}" || "${JOIN_CMD}" == "None" ]]; then
  echo "ERROR: join_command is empty. Provide a valid kubeadm join command."
  exit 2
fi

# Ensure containerd is running before attempting join
if ! systemctl is-active --quiet containerd; then
  echo "containerd is not active. Attempting to start containerd..."
  systemctl enable --now containerd
  sleep 3
fi

# Add --v=4 for verbose logs to help debugging in CI/automation
FULL_CMD="${JOIN_CMD} ${KUBEADM_FLAGS} --v=4"

echo "Attempting to join the cluster using:"
echo "  ${FULL_CMD}"

i=0
while [[ $i -lt ${RETRY_COUNT} ]]; do
  set +e
  bash -c "${FULL_CMD}"
  rc=$?
  set -e
  if [[ $rc -eq 0 ]]; then
    echo "kubeadm join succeeded"
    exit 0
  fi

  # If already joined, treat as success
  if journalctl -u kubelet -n 200 | grep -qi "already joined"; then
    echo "Node already joined according to kubelet logs; exiting successfully."
    exit 0
  fi

  echo "kubeadm join failed (attempt $((i+1))/${RETRY_COUNT}), rc=${rc}. Retrying in ${RETRY_DELAY}s..."
  sleep "${RETRY_DELAY}"
  i=$((i+1))
done

echo "kubeadm join failed after ${RETRY_COUNT} attempts."
exit 1
